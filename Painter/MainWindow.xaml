<Window x:Class="Painter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Painter"
        mc:Ignorable="d"
        Title="Painter" Height="450" Width="800" MouseDown="cmDown" MouseUp="cmUp" MouseMove="cmMove">
    <Grid>
        <Canvas x:Name="g" Margin="10,10,10,126" Background="#FFC3FEFF" Width="780" Height="298.04"/>
        <RadioButton x:Name="rbBlue" Content="Синий" HorizontalAlignment="Left" Margin="107,354,0,0" VerticalAlignment="Top" Checked="cmBlue" GroupName="Color"/>
        <RadioButton x:Name="rbReb" Content="Красный" HorizontalAlignment="Left" Margin="107,334,0,0" VerticalAlignment="Top" Checked="cmRed" GroupName="Color"/>
        <RadioButton x:Name="rbGreen" Content="Зелёный" HorizontalAlignment="Left" Margin="107,374,0,0" VerticalAlignment="Top" Checked="cmGreen" GroupName="Color"/>
        <Rectangle x:Name="rColor" HorizontalAlignment="Left" Height="60" Margin="42,330,0,0" Stroke="Black" VerticalAlignment="Top" Width="60"/>
        <Slider x:Name="slSize" HorizontalAlignment="Left" Margin="243,352,0,0" VerticalAlignment="Top" Width="250" Height="17" ValueChanged="cmSize"/>
        <Button Content="Отчистить" HorizontalAlignment="Left" Margin="579,339,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.334,0.335" Height="45" Width="142" Click="cmClear"/>

    </Grid>
</Window>
